   "source": [
    "## 7. Sampling hazards onto the network\n",
    "\n",
    "Each road is densified to half the raster resolution, every vertex is looked up in the grid by\n",
    "inverse affine transform, and the values are reduced per road with the layer's statistic. This\n",
    "is vectorised across the whole network — one pass per hazard, not one pass per road.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "cell-21",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-25T10:48:30.287088Z",
     "iopub.status.busy": "2026-08-25T10:48:30.286831Z",
     "iopub.status.idle": "2026-08-25T10:48:30.293214Z",
     "shell.execute_reply": "2026-08-25T10:48:30.292106Z"
    }
   },
   "outputs": [],
   "source": [
    "def sample_raster_to_roads(\n",
    "    roads_in_raster_crs: gpd.GeoDataFrame, raster: Raster, stat: str = \"max\"\n",
    ") -> np.ndarray:\n",
    "    \"\"\"Reduce *raster* along every road geometry; returns one value per row.\n",
    "\n",
    "    Roads must already be in the raster CRS. Roads that fall entirely outside the\n",
    "    grid, or only over nodata, return NaN.\n",
    "    \"\"\"\n",
    "    step = raster.resolution / 2\n",
    "    dense = shapely.segmentize(roads_in_raster_crs.geometry.values, max_segment_length=step)\n",
    "    coords, index = shapely.get_coordinates(dense, return_index=True)\n",
    "\n",
    "    cols, rows = ~raster.transform * (coords[:, 0], coords[:, 1])\n",
    "    rows = np.floor(rows).astype(int)\n",
    "    cols = np.floor(cols).astype(int)\n",
    "\n",
    "    height, width = raster.data.shape\n",
    "    inside = (rows >= 0) & (rows < height) & (cols >= 0) & (cols < width)\n",
    "\n",
    "    values = np.full(len(coords), np.nan)\n",
    "    values[inside] = raster.data[rows[inside], cols[inside]]\n",
    "\n",
    "    reduced = (\n",
    "        pd.DataFrame({\"road\": index, \"value\": values})\n",
    "        .groupby(\"road\")[\"value\"]\n",
    "        .agg(stat)\n",
    "    )\n",
    "    out = np.full(len(roads_in_raster_crs), np.nan)\n",
    "    out[reduced.index.to_numpy()] = reduced.to_numpy()\n",
    "    return out\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "cell-22",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-25T10:48:30.296048Z",
