     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Trend: median +27.3 mm/decade over 1,680 pixels\n",
      "       p<0.05 uncorrected : 263 (15.7%) | 249 increasing, 14 decreasing\n",
      "       BH-FDR q<0.05      : 0 (0.0%) — these are the pixels the layer keeps\n"
     ]
